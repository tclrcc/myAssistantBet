# Facade nginx pour MyAssistantBet.
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/myassistantbet.conf
#   sudo ln -s /etc/nginx/sites-available/myassistantbet.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Le nom d'hote est celui que le fournisseur attribue au VPS : il resout deja
# publiquement, ce qui suffit a Let's Encrypt. Aucun domaine a acheter.
# Remplacer les trois occurrences en cas de deploiement ailleurs.
#
# IMPORTANT — l'application n'a **aucune authentification** : c'est un choix
# assume (SPEC.md section 1), et c'est donc ce proxy qui la protege. Ne pas
# deployer sans l'authentification basique ci-dessous, ou sans une restriction
# equivalente (VPN, filtrage par IP). Ce n'est pas une precaution de principe :
# un `/scan` depense de vrais credits The Odds API, et la base porte tout
# l'historique de paris.

server {
    listen 80;
    listen [::]:80;
    server_name vps-5ff241d3.vps.ovh.net;

    # Laisse passer le renouvellement du certificat, redirige tout le reste.
    # Cet emplacement doit rester avant la redirection : certbot valide en
    # HTTP, et une redirection vers HTTPS ferait echouer le renouvellement.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;                       # nginx >= 1.25.1 ; avant : `listen 443 ssl http2;`
    server_name vps-5ff241d3.vps.ovh.net;

    # Certificats produits par certbot :
    #   sudo certbot certonly --webroot -w /var/www/html -d <nom d'hote>
    ssl_certificate     /etc/letsencrypt/live/vps-5ff241d3.vps.ovh.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vps-5ff241d3.vps.ovh.net/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # --- Authentification -------------------------------------------------
    # Seule barriere devant l'application. Declaree au niveau du serveur, donc
    # valable aussi pour /static : une page protegee dont la feuille de style
    # est publique livrerait deja la moitie du sujet.
    #   sudo apt install apache2-utils
    #   sudo htpasswd -c /etc/nginx/myassistantbet.htpasswd <utilisateur>
    auth_basic "MyAssistantBet";
    auth_basic_user_file /etc/nginx/myassistantbet.htpasswd;

    access_log /var/log/nginx/myassistantbet.access.log;
    error_log  /var/log/nginx/myassistantbet.error.log;

    # **Plus aucun televersement depuis le retrait des coupons (28/08/2026)**,
    # et la borne reste : ce qui passe par ici est un collage de rendu, qui pese
    # 30 Ko. Six megaoctets laissent la marge sans qu'un 413 muet de nginx
    # remplace le message de l'application.
    client_max_body_size 6m;

    location / {
        proxy_pass http://127.0.0.1:8021;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # L'enrichissement peut durer une minute sur une grosse selection.
        proxy_connect_timeout 10s;
        proxy_read_timeout    120s;
        proxy_send_timeout    120s;

        # Le polling HTMX de la barre de progression doit arriver sans delai.
        proxy_buffering off;
    }

    # Les fichiers statiques sont peu nombreux et changent a chaque deploiement.
    location /static/ {
        proxy_pass http://127.0.0.1:8021/static/;
        proxy_set_header Host $host;
        expires 1h;
        add_header Cache-Control "public";
    }
}

# Sauvegarde ponctuelle de la base. Declenchee par myassistantbet-backup.timer.
#
#   sudo cp deploy/myassistantbet-backup.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now myassistantbet-backup.timer
#
# Declenchement manuel :  sudo systemctl start myassistantbet-backup
#
# Les chemins suivent ceux de myassistantbet.service : les deux unites doivent
# designer la meme installation, sinon la sauvegarde porte sur une autre base.

[Unit]
Description=Sauvegarde de la base MyAssistantBet
Documentation=https://github.com/tclrcc/myAssistantBet

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/myAssistantBet
EnvironmentFile=/home/ubuntu/myAssistantBet/.env

ExecStart=/home/ubuntu/.local/bin/uv run --frozen myassistantbet-backup

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# `read-only` et non `true` : l'application vit dans le home, qui doit rester
# lisible et executable. Voir le meme commentaire dans myassistantbet.service.
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/myAssistantBet/data
ReadWritePaths=/home/ubuntu/myAssistantBet/.venv
Environment=UV_CACHE_DIR=/home/ubuntu/myAssistantBet/data/.uv-cache

SyslogIdentifier=myassistantbet-backup

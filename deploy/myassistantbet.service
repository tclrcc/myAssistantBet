# Unite systemd de MyAssistantBet.
#
#   sudo cp deploy/myassistantbet.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now myassistantbet
#
# Les chemins ci-dessous decrivent le deploiement reel : l'application vit dans
# le home de l'utilisateur `ubuntu`, comme les autres services de la machine.
# Pour une installation ailleurs, adapter User, Group, WorkingDirectory et les
# ReadWritePaths ensemble — ils se repondent.
#
# Le port 8021 n'est pas un detail : 8000, cite dans les premieres versions de
# ce fichier, est deja occupe sur cette machine. uvicorn n'ecoute que sur la
# boucle locale, l'exposition passe par nginx (deploy/nginx.conf.example).

[Unit]
Description=MyAssistantBet — collecte de cotes et generation de prompt
Documentation=https://github.com/tclrcc/myAssistantBet
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/myAssistantBet

# Secrets et configuration. Ce fichier doit etre en 0600, propriete du service.
EnvironmentFile=/home/ubuntu/myAssistantBet/.env

# `uv run` resout l'environnement virtuel du projet sans l'activer a la main.
ExecStart=/home/ubuntu/.local/bin/uv run --frozen uvicorn myassistantbet.main:app \
    --host 127.0.0.1 --port 8021 --proxy-headers --forwarded-allow-ips 127.0.0.1

Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

# --- Durcissement ---------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# `read-only` et non `true` : l'application est installee dans le home, qui
# doit rester lisible et executable (le binaire `uv` y vit aussi). Les seuls
# chemins ouverts en ecriture sont ceux listes plus bas.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Seuls ces chemins sont accessibles en ecriture : la base et les sauvegardes,
# les captures de coupons, les templates de prompt (editables depuis l'UI) et
# le cache de uv.
ReadWritePaths=/home/ubuntu/myAssistantBet/data
ReadWritePaths=/home/ubuntu/myAssistantBet/src/myassistantbet/templates/prompts
ReadWritePaths=/home/ubuntu/myAssistantBet/.venv
Environment=UV_CACHE_DIR=/home/ubuntu/myAssistantBet/data/.uv-cache

# --- Journalisation -------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=myassistantbet

[Install]
WantedBy=multi-user.target

# Copier en `.env` et renseigner. Ce fichier ne contient jamais de vraie cle.

# --- Secrets ---------------------------------------------------------------
ODDS_API_KEY=
APIFOOTBALL_KEY=

# --- Base de donnees -------------------------------------------------------
DB_PATH=./data/myassistantbet.db

# --- Affichage -------------------------------------------------------------
TZ=Europe/Paris

# --- Garde-fous quota ------------------------------------------------------
# Blocage de l'etage B (marches profonds) sous ce seuil de credits restants.
ODDS_API_CREDIT_FLOOR=500

# --- Contexte sportif (etage B) --------------------------------------------
# Competitions (cles The Odds API) pour lesquelles demander les props buteurs.
# Ailleurs ces marches ne sont servis par personne : ne pas depenser de credit.
PLAYER_PROPS_LEAGUES=soccer_epl,soccer_france_ligue_one,soccer_spain_la_liga,soccer_germany_bundesliga,soccer_italy_serie_a,soccer_usa_mls

# --- Sauvegardes -----------------------------------------------------------
# VACUUM INTO quotidien, avec rotation. La derniere sauvegarde n'est jamais
# supprimee, meme au-dela du delai.
BACKUP_DIR=./data/backups
BACKUP_KEEP_DAYS=7

# --- Captures de coupons ---------------------------------------------------
# Les captures d'ecran jointes aux paris joues. Sous data/, donc deja couvertes
# par le ReadWritePaths de l'unite systemd et par le .gitignore. Elles ne sont
# PAS incluses dans la sauvegarde, qui ne porte que sur la base.
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=5000000

# --- Appels externes -------------------------------------------------------
# Base du backoff exponentiel entre deux tentatives, en secondes (1 -> 1s puis 2s).
HTTP_BACKOFF_BASE=1.0

# --- Developpement ---------------------------------------------------------
# Met en cache sur disque les reponses d'API pour ne pas bruler le quota.
DEV_CACHE=0
DEV_CACHE_DIR=./data/dev_cache

# --- Fenetre de scan -------------------------------------------------------
# Nombre de jours glissants a scanner a partir d'aujourd'hui (2 = J+0 et J+1).
SCAN_WINDOW_DAYS=2

# --- Scan quotidien (heure locale TZ) --------------------------------------
SCHEDULER_ENABLED=1
SCAN_HOUR=7
SCAN_MINUTE=0

# --- Substituts de Betclic chez API-Football --------------------------------
# Betclic n'est pas au catalogue de ce fournisseur : pour les matchs que The Odds
# API ne sert pas du tout, les cotes sont relevees chez le premier book present
# de cette liste. L'ordre est mesure : ecart moyen absolu au prix Betclic de
# 3.0 % pour BetVictor, 3.4 % pour William Hill et 888Sport, contre 5.4 % pour
# Unibet et 6.0 % pour Pinnacle. Ces prix ne sont jamais jouables tels quels et
# portent le suffixe « (ref.) ».
APIFOOTBALL_BOOKMAKERS=888Sport,William Hill,BetVictor,10Bet,Bet365,Superbet
